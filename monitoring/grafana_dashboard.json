{
  "title": "SecureFlow Dashboard - Observabilidad",
  "panels": [
    { "title": "Uso de CPU", "targets": [{ "expr": "rate(process_cpu_seconds_total[1m])" }] },
    { "title": "Uso de Memoria (RAM)", "targets": [{ "expr": "process_resident_memory_bytes" }] },
    { "title": "Peticiones por Segundo (RPS)", "targets": [{ "expr": "rate(http_requests_total[1m])" }] },
    { "title": "Latencia Promedio (s)", "targets": [{ "expr": "rate(http_request_duration_seconds_sum[1m]) / rate(http_request_duration_seconds_count[1m])" }] },
    { "title": "Errores HTTP (5xx)", "targets": [{ "expr": "rate(http_requests_total{status=~\"5..\"}[1m])" }] }
  ]
}